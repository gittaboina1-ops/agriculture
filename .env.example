# AgriGraph Environment Configuration
PROJECT_NAME="AgriGraph API"
VERSION="1.0.0"

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Application Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=agrigraph_db

# NLP / Semantic Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Resilient Offline / Demo Mode
USE_MOCK_FALLBACK=true

# Security & Authentication
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_SIGNUP_CODE=AGRIGRAPH_ADMIN_2026

# Seed Credentials (configured via environment, hashed on insertion)
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
